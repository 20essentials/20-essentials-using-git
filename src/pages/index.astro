---
import Background from '@/components/Background.astro';
import ContainerCards from '@/components/ContainerCards.astro';
import Hero from '@/components/Hero.astro';
import Layout from '@/layouts/Layout.astro';
---

<Layout>
  <Background />
  <section class='am-your-container'>
    <Hero />
    <ContainerCards />
  </section>
</Layout>

<style>
  .am-your-container {
    height: 200vh;

    @media (width <= 1111px) and (orientation: portrait) {
      height: 100vh;
    }
  }
</style>
